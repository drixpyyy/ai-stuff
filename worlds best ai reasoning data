(function(){
    // ─── constants ──────────────────────────────────────────────────────────
    const F=512, B=64, ITER=50, LR=0.001, TARGET=0.5;
    const LOG_INTERVAL_MS=500;
    const FLOP_PER_RUN = B*ITER*(8*F+13);
    const MAX_LOG=500;

    // ─── WASM binaries (SIMD + scalar fallback) ──────────────────────────
    const SIMD_B64 = "";
    const SCAL_B64 = "";

    // ─── detect SIMD ──────────────────────────────────────────────────────
    function simdSupported(){
        try{
            const bytes = Uint8Array.from(atob(SIMD_B64), c => c.charCodeAt(0));
            new WebAssembly.Module(bytes);
            return true;
        }catch(e){ return false; }
    }
    const USE_SIMD = simdSupported();
    const WASM_B64 = USE_SIMD ? SIMD_B64 : SCAL_B64;

    // ─── DOM refs ──────────────────────────────────────────────────────────
    const $ = id => document.getElementById(id);
    const statusMsg = $('status-msg');
    const flopsSpan = $('totalFlops');
    const opsSpan = $('totalOps');
    const speedSpan = $('speed');
    const elapsedSpan = $('elapsed');
    const logDiv = $('log');
    const coreSpan = $('coreCount');

    // ─── state ─────────────────────────────────────────────────────────────
    let running = false, paused = false;
    let totalFlops = 0, totalOps = 0;
    let startTime = 0, lastLogTime = 0;
    let workerFlops = [];
    let workers = [];
    let logCount = 0;

    // ─── worker count: use all logical cores (leave one for UI if possible) ─
    const MAX_CORES = navigator.hardwareConcurrency || 2;
    const NWORKERS = Math.max(1, MAX_CORES > 1 ? MAX_CORES - 1 : MAX_CORES);
    coreSpan.textContent = NWORKERS;

    // ─── worker source (inlined) ──────────────────────────────────────────
    const workerSrc = `
        const F=${F}, B=${B}, ITER=${ITER}, LR=${LR}, TARGET=${TARGET};
        const FLOP_PER_RUN = ${FLOP_PER_RUN};
        const WASM_B64 = "${WASM_B64}";
        let totalFlops = 0;
        self.onmessage = function(e){
            if(e.data.cmd !== "start") return;
            try{
                const bytes = Uint8Array.from(atob(WASM_B64), c => c.charCodeAt(0));
                const memory = new WebAssembly.Memory({ initial: 128 });
                WebAssembly.instantiate(bytes, { env: { memory } }).then(inst => {
                    const percep = inst.instance.exports.perceptron;
                    const wOff = 0, xOff = F * 4;
                    const weights = new Float32Array(memory.buffer, wOff, F);
                    const inputs  = new Float32Array(memory.buffer, xOff, B * F);
                    for(let i=0; i<F; i++) weights[i] = Math.random()*2 - 1;
                    for(let i=0; i<B*F; i++) inputs[i] = Math.random()*2 - 1;
                    self.postMessage({ log: "worker ready" });
                    const LOOP_MS = 50;  // slightly longer chunk to reduce messaging
                    const loop = () => {
                        const end = performance.now() + LOOP_MS;
                        let n = 0;
                        while(performance.now() < end){
                            percep(wOff, xOff, F, B, ITER, LR, TARGET);
                            n++;
                        }
                        totalFlops += n * FLOP_PER_RUN;
                        self.postMessage({ flops: totalFlops });
                        setTimeout(loop, 0);
                    };
                    loop();
                }).catch(err => self.postMessage({ err: "wasm: " + err }));
            }catch(err){ self.postMessage({ err: String(err) }); }
        };
