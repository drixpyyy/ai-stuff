        }
        .btn-primary {
            background: linear-gradient(90deg, #FF6B00, #FF4500);
            color: #fff;
        }
        .btn-primary:hover:not(:disabled) { transform: scale(1.02); box-shadow: 0 0 30px rgba(255,107,0,0.3); }
        .btn-primary:disabled { opacity: 0.5; cursor: not-allowed; }
        .btn-secondary { background: rgba(255,255,255,0.1); color: #fff; border: 1px solid #444; }
        .result-highlight {
            text-align: center;
            padding: 20px;
            background: rgba(255,107,0,0.1);
            border-radius: 12px;
            margin: 10px 0;
        }
        .gflops-number { font-size: 3em; font-weight: bold; color: #ffd700; }
        .footer { text-align: center; color: #555; font-size: 0.8em; margin-top: 20px; }
        @media (max-width:600px) {
            .container { padding: 15px; }
            h1 { font-size: 1.5em; }
            .info-grid { grid-template-columns: 1fr; }
            .gflops-number { font-size: 2em; }
        }
    </style>
