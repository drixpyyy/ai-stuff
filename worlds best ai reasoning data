        workers.forEach(w => w.terminate());
        workers = [];
        workerFlops = [];
    }

    // ─── main UI loop (runs at ~60fps) ──────────────────────────────────
    function updateUI(){
        if(!running && !paused){
            requestAnimationFrame(updateUI);
            return;
        }
        if(!paused){
            totalFlops = workerFlops.reduce((a,b) => a + b, 0);
            totalOps = totalFlops;
            const elapsed = (performance.now() - startTime) / 1000;
            const speed = elapsed > 0 ? totalFlops / elapsed / 1e9 : 0;
            flopsSpan.textContent = totalFlops.toExponential(4);
            opsSpan.textContent = totalOps.toExponential(4);
            speedSpan.textContent = speed.toFixed(4);
            elapsedSpan.textContent = elapsed.toFixed(2);

            if(performance.now() - lastLogTime > LOG_INTERVAL_MS){
                lastLogTime = performance.now();
                addLog('[' + elapsed.toFixed(2) + 's] ' +
                       (totalFlops/1e9).toFixed(3) + 'G FLOPs | ' +
                       speed.toFixed(3) + ' GFLOPS/s');
            }
        }
